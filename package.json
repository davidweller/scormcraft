{
  "name": "scorm-course-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate && tsx scripts/make-sqlite-schema.ts && prisma generate --schema prisma/sqlite/schema.prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "gc:scorm-imports": "tsx scripts/gc-scorm-imports.ts",
    "db:migrate:desktop": "tsx scripts/make-sqlite-schema.ts && prisma migrate dev --schema prisma/sqlite/schema.prisma",
    "desktop:dev": "tsx scripts/make-sqlite-schema.ts && prisma generate --schema prisma/sqlite/schema.prisma && concurrently -k -n next,app \"node electron/dev-server.js\" \"electron .\"",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:build:win": "node scripts/build-desktop.mjs --win"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@google/genai": "^1.43.0",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@vercel/blob": "^0.24.0",
    "cheerio": "^1.2.0",
    "docx": "^9.6.0",
    "dompurify": "^3.4.16",
    "fast-xml-parser": "^4.5.7",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "marked": "^18.0.7",
    "next": "14.2.18",
    "openai": "^6.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.47",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9",
    "wait-on": "^9.5.1"
  },
  "main": "electron/main.js",
  "productName": "SCORMcraft"
}
