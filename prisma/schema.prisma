// SCORM Course Builder - Prisma schema
// One local SQLite file per install; see src/lib/desktop/migrate.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Course {
  id               String   @id @default(cuid())
  title            String
  overview         String?
  audience         String?  // e.g. "undergraduate", "corporate L&D"
  targetWordCount  Int?     // Target word count for the entire course
  tone             String?  // e.g. "formal", "conversational"
  complianceLevel  String?  // e.g. "standard", "strict"
  brandConfig      Json?    // { primary, secondary, accent, background, logoUrl, font }
  settings         Json?    // e.g. { apiKeys: { openai?: string } } for BYO keys
  ilos             Json?    // string[] learning outcomes
  assessmentPlan   Json?    // string or { summary, placements } for blueprint
  interactionConfig Json?   // { enabledTypes, density, placement, includeExplanations }
  interactionsReviewedAt DateTime?
  lastPreviewedAt  DateTime?
  lastExportedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  modules         Module[]
  snapshots       CourseSnapshot[]
}

// A saved copy of a course's outline and content, taken before an action
// that replaces or deletes content, so the author can go back.
model CourseSnapshot {
  id        String   @id @default(cuid())
  courseId  String
  reason    String   // What was about to happen, e.g. "Before regenerating Lesson 2"
  data      Json     // SnapshotData, see src/lib/snapshots.ts
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int      @default(0)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id       String @id @default(cuid())
  moduleId String
  title    String
  order    Int    @default(0)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  pages    Page[]
}

model Page {
  id          String   @id @default(cuid())
  lessonId    String
  title       String
  order       Int      @default(0)
  completionRules Json? // e.g. { type: "all_blocks_viewed" }
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  blocks      Block[]
}

model Block {
  id       String @id @default(cuid())
  pageId   String
  category String // "content" | "interaction"
  type     String // content: text, heading, image, video_embed, key_insight, key_point
                  // interaction: multiple_choice, true_false, reflection, drag_and_drop, matching, dialog_cards
  data     Json   // content or config depending on category
  order    Int    @default(0)
  page     Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  alt       String?
  source    String   @default("upload") // "upload" | "ai_generated"
  prompt    String?  // AI generation prompt if source is ai_generated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
