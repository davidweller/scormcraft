# All optional. Keys can also be added in the app's Settings, which stores
# them in the data folder. The app sets its own database and storage paths.

# OpenAI API (content generation)
OPENAI_API_KEY="sk-..."

# Anthropic API (content generation)
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini API (AI image generation)
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenAI model for course import (default: gpt-5-mini)
# Other options: gpt-5, gpt-5-nano, gpt-4o
OPENAI_IMPORT_MODEL="gpt-5-mini"
